{
  "name": "spiders",
  "version": "0.1.0",
  "private": true,
  "description": "Crawlers for Ivy League open / MOOC course listings",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "crawl:harvard": "tsx MOOC/harvard/crawler.ts",
    "clean:harvard": "tsx MOOC/harvard/clean.ts",
    "crawl:yale": "tsx MOOC/yale/crawler.ts",
    "clean:yale": "tsx MOOC/yale/clean.ts",
    "crawl:princeton": "tsx MOOC/princeton/crawler.ts",
    "clean:princeton": "tsx MOOC/princeton/clean.ts",
    "crawl:columbia": "tsx MOOC/columbia/crawler.ts",
    "clean:columbia": "tsx MOOC/columbia/clean.ts",
    "crawl:upenn": "tsx MOOC/upenn/crawler.ts",
    "clean:upenn": "tsx MOOC/upenn/clean.ts",
    "crawl:brown": "tsx MOOC/brown/crawler.ts",
    "clean:brown": "tsx MOOC/brown/clean.ts",
    "crawl:dartmouth": "tsx MOOC/dartmouth/crawler.ts",
    "clean:dartmouth": "tsx MOOC/dartmouth/clean.ts",
    "crawl:cornell": "tsx MOOC/cornell/crawler.ts",
    "clean:cornell": "tsx MOOC/cornell/clean.ts",
    "crawl:all": "npm run crawl:harvard && npm run crawl:yale && npm run crawl:princeton && npm run crawl:columbia && npm run crawl:upenn && npm run crawl:brown && npm run crawl:dartmouth && npm run crawl:cornell",
    "clean:all": "npm run clean:harvard && npm run clean:yale && npm run clean:princeton && npm run clean:columbia && npm run clean:upenn && npm run clean:brown && npm run clean:dartmouth && npm run clean:cornell",
    "ingest": "tsx MOOC/ingest.ts",
    "all": "tsx scripts/run-all.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0"
  }
}
