{
  "name": "spiders",
  "version": "0.1.0",
  "private": true,
  "description": "Crawlers for open course listings (MOOC), 志愿填报/职业规划 master data (CAREER) and public job postings (JOBS)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "crawl:harvard": "tsx MOOC/harvard/crawler.ts",
    "clean:harvard": "tsx MOOC/harvard/clean.ts",
    "crawl:yale": "tsx MOOC/yale/crawler.ts",
    "clean:yale": "tsx MOOC/yale/clean.ts",
    "crawl:princeton": "tsx MOOC/princeton/crawler.ts",
    "clean:princeton": "tsx MOOC/princeton/clean.ts",
    "crawl:columbia": "tsx MOOC/columbia/crawler.ts",
    "clean:columbia": "tsx MOOC/columbia/clean.ts",
    "crawl:upenn": "tsx MOOC/upenn/crawler.ts",
    "clean:upenn": "tsx MOOC/upenn/clean.ts",
    "crawl:brown": "tsx MOOC/brown/crawler.ts",
    "clean:brown": "tsx MOOC/brown/clean.ts",
    "crawl:dartmouth": "tsx MOOC/dartmouth/crawler.ts",
    "clean:dartmouth": "tsx MOOC/dartmouth/clean.ts",
    "crawl:cornell": "tsx MOOC/cornell/crawler.ts",
    "clean:cornell": "tsx MOOC/cornell/clean.ts",
    "crawl:stanford": "tsx MOOC/stanford/crawler.ts",
    "clean:stanford": "tsx MOOC/stanford/clean.ts",
    "crawl:mit": "tsx MOOC/mit/crawler.ts",
    "clean:mit": "tsx MOOC/mit/clean.ts",
    "crawl:all": "npm run crawl:harvard && npm run crawl:yale && npm run crawl:princeton && npm run crawl:columbia && npm run crawl:upenn && npm run crawl:brown && npm run crawl:dartmouth && npm run crawl:cornell && npm run crawl:stanford && npm run crawl:mit",
    "clean:all": "npm run clean:harvard && npm run clean:yale && npm run clean:princeton && npm run clean:columbia && npm run clean:upenn && npm run clean:brown && npm run clean:dartmouth && npm run clean:cornell && npm run clean:stanford && npm run clean:mit",
    "ingest": "tsx MOOC/ingest.ts",
    "all": "tsx scripts/run-group.ts MOOC",
    "career:migrate": "tsx CAREER/migrate.ts",
    "crawl:career-majors": "tsx CAREER/moe_majors/crawler.ts",
    "clean:career-majors": "tsx CAREER/moe_majors/clean.ts",
    "crawl:career-occupations": "tsx CAREER/occupations/crawler.ts",
    "clean:career-occupations": "tsx CAREER/occupations/clean.ts",
    "crawl:career-curriculum": "tsx CAREER/curriculum/crawler.ts",
    "clean:career-curriculum": "tsx CAREER/curriculum/clean.ts",
    "career:curriculum:try": "tsx CAREER/curriculum/try.ts",
    "test:career": "tsx --test CAREER/curriculum/test/*.test.ts",
    "test:jobs": "tsx --test JOBS/test/*.test.ts",
    "career:tag-skills": "tsx CAREER/curriculum/tag.ts",
    "career:ingest": "tsx CAREER/ingest.ts",
    "career:all": "tsx scripts/run-group.ts CAREER",
    "crawl:jobs-upc": "tsx JOBS/upc/crawler.ts",
    "clean:jobs-upc": "tsx JOBS/upc/clean.ts",
    "jobs:crawl": "npm run crawl:jobs-upc && npm run clean:jobs-upc",
    "jobs:ingest": "tsx JOBS/ingest.ts",
    "jobs:stats": "tsx JOBS/stats.ts",
    "jobs:reclassify": "tsx JOBS/ingest.ts --no-sources",
    "jobs:compare": "tsx JOBS/compare.ts",
    "jobs:all": "tsx scripts/run-group.ts JOBS",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/client",
    "web:server": "tsx web/server/index.ts",
    "web:dev": "concurrently -k -n api,ui -c blue,magenta \"tsx watch --clear-screen=false web/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "web:dev:student": "vite --config web/vite.student.config.ts",
    "web:build": "vite build --config web/vite.config.ts && vite build --config web/vite.student.config.ts",
    "web:start": "tsx web/server/index.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  }
}
