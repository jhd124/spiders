{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/**/*.ts",
    "MOOC/**/*.ts",
    "scripts/**/*.ts",
    "web/server/**/*.ts",
    "web/shared/**/*.ts",
    "web/vite.config.ts"
  ]
}
